# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://grocery_user:change-me@localhost:5432/grocery_db
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10

# Signs the login session cookie. setup.bat writes a strong random value here automatically.
# Generate one by hand with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 1 when the app is served over HTTPS (production); keeps the session cookie off plain HTTP
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_HOURS=12

# Set to 1 only on your own machine: enables the Flask debugger and auto-reload
FLASK_DEBUG=0
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=5000

# Comma-separated origins allowed to call the API from another site.
# Leave empty when the UI is served by this app at http://HOST:PORT/
CORS_ORIGINS=
